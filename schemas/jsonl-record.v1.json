{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t3-thread.dev/schemas/jsonl-record.v1.json",
  "title": "t3-thread JSONL record",
  "description": "Records after the thread header are emitted in chronological order by event timestamp, with null-timestamp records last, ties broken by record type then by the type's stable identifier.",
  "type": "object",
  "required": ["schemaVersion", "recordType", "threadId", "data"],
  "properties": {
    "schemaVersion": { "const": "t3-thread.jsonl-record.v1" },
    "recordType": {
      "type": "string",
      "enum": ["thread", "turn", "message", "activity", "list", "participants", "participant"]
    },
    "threadId": { "type": ["string", "null"] },
    "data": { "type": "object" },
    "provider": { "type": "object" },
    "warnings": { "type": "array" }
  },
  "additionalProperties": false
}
